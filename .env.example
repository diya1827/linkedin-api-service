# Copy to .env and fill in real values. Do NOT commit .env.

# Application Settings
ENVIRONMENT=development
DEBUG=True
REQUEST_TIMEOUT=15.0

# LinkedIn Session Credentials (from an authenticated browser session).
# LINKEDIN_LI_AT_COOKIE  -> value of the "li_at" cookie
# LINKEDIN_JSESSIONID    -> value of the "JSESSIONID" cookie (e.g. ajax:1234567890)
LINKEDIN_LI_AT_COOKIE=
LINKEDIN_JSESSIONID=ajax:1234567890

# RECOMMENDED: paste the FULL Cookie header from a real browser request here.
# DevTools > Network > click any "voyager" request > Request Headers > Cookie >
# copy the entire value. This includes lidc/bcookie/liap/etc. that LinkedIn's
# anti-automation requires on protected endpoints (e.g. the profile graphql call).
# When set, this OVERRIDES the two vars above.
LINKEDIN_COOKIE=

# GraphQL queryId for the identity profile query. LinkedIn rotates this every
# few weeks. Capture the current value from your browser:
#   DevTools > Network > filter "graphql" > open a profile > copy the queryId=... param
# Example format: voyagerIdentityDashProfiles.<hash>
# If left blank, the service falls back to the legacy profileView endpoint.
LINKEDIN_PROFILE_QUERY_ID=

# Expose /api/v1/debug/* routes. These drive arbitrary Voyager requests with the
# server's session cookie — keep FALSE on any public deploy. Local debugging only.
ENABLE_DEBUG_ROUTES=false

# Serve a cached profile for this many seconds (keyed on handle).
CACHE_TTL_SECONDS=900

# Max parse-profile requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=20

# Optional outbound proxy for LinkedIn requests (e.g. a residential proxy).
# LinkedIn flags IPs that send automated traffic; a rotating residential proxy is
# how this is run reliably. Format: http://user:pass@host:port  (empty = direct).
LINKEDIN_PROXY=

# Browser identity to present on every request: windows | macos. Must match the
# browser you copied the cookies from, or LinkedIn revokes the session.
LINKEDIN_BROWSER_PLATFORM=windows
